# Copy to .env for local development. CI supplies these as workflow variables.

# GTM container ID (GTM-XXXXXXX). Leave empty to skip loading analytics entirely.
GTM=

# Origin the header is served from, no protocol or trailing slash.
# The session endpoint lives at ROOT_URL/api/session.
#
# 4321 is the static-only dev server (npm run dev). 4280 is the Static Web Apps
# emulator (npm run dev:api), the only one that serves /api — so point this at
# 4280 whenever UCFHB_SESSION=1.
ROOT_URL=localhost:4280

# Where the search form submits. This is the Google Custom Search page —
# NOT search.cm.ucf.edu, which is the data API hub.
SEARCH_URL=https://search.ucf.edu/

# Set to 1 to compile in the Phase 2 signed-in seam. Off for 4.0.0.
# Costs ~1 KB gzipped. See api/README.md.
UCFHB_SESSION=0

# The API's own settings live in api/local.settings.json (copy the .example).
# In Azure they are Static Web App application settings, applied by
# scripts/api-settings.sh — never by the deploy workflow.
