{
  "name": "ucf-header-api",
  "version": "0.1.0",
  "private": true,
  "description": "Session and profile endpoint for the UCF universal header.",
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prestart": "npm run build",
    "start": "func start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev:func": "npm run build && func start --port 7071",
    "dev:swa": "swa start ../dist --api-devserver-url http://localhost:7071 --port 4280"
  },
  "dependencies": {
    "@azure/functions": "^4.6.0",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@azure/static-web-apps-cli": "^2.0.10",
    "@types/node": "^22.10.0",
    "azure-functions-core-tools": "^4.14.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
