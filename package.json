{
  "name": "ucf-header",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "The UCF universal header — a single-file, drop-in bar embedded across the UCF web infrastructure.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/build.mjs --watch --serve",
    "build": "node scripts/build.mjs",
    "size": "node scripts/size.mjs",
    "bench": "node scripts/bench/index.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=e2e-chromium --project=e2e-firefox --project=e2e-webkit",
    "test:visual": "playwright test --project=visual-chromium --project=visual-firefox --project=visual-webkit",
    "test:visual:update": "npm run test:visual -- --update-snapshots",
    "test:visual:docker": "node scripts/visual-docker.mjs",
    "test:a11y": "playwright test --project=a11y",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run size"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@biomejs/biome": "^2.0.0",
    "@playwright/test": "1.62.1",
    "@types/node": "^22.10.0",
    "browserslist": "^4.28.8",
    "esbuild": "^0.28.2",
    "jsdom": "^26.0.0",
    "lightningcss": "^1.29.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "not dead"
  ]
}
